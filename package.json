{
  "name": "cameras-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo: cliente web + servidor + agent para visualizar camaras IP de la red local en vivo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,agent,web -c blue,magenta,green \"npm run dev -w @cameras/server\" \"npm run dev -w @cameras/agent\" \"npm run dev -w @cameras/web\"",
    "dev:server": "npm run dev -w @cameras/server",
    "dev:agent": "npm run dev -w @cameras/agent",
    "dev:web": "npm run dev -w @cameras/web",
    "discover": "node tools/lan-scan.mjs",
    "discover:onvif": "node tools/onvif-discover.mjs",
    "db:ping": "node tools/db-ping.mjs",
    "cloud:ping": "tsx tools/cloudinary-ping.ts",
    "test:relay": "node tools/relay-test.mjs",
    "test:onvif": "node tools/onvif-selftest.mjs",
    "test:f4": "node tools/f4-test.mjs",
    "test:f5": "node tools/f5-test.mjs",
    "test:ui": "node tools/ui-test.mjs",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @cameras/server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"const f=require('fs'),p=['apps/server/dist','apps/agent/dist','apps/web/dist','node_modules/.vite'];p.forEach(d=>{try{f.rmSync(d,{recursive:true,force:true})}catch(e){}})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
