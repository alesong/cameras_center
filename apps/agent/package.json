{
  "name": "@cameras/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daemon edge en la LAN: descubre camaras, lee RTSP con FFmpeg y hace push al server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p ../../tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cameras/core": "*",
    "@cameras/protocol": "*",
    "dotenv": "^16.4.7",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  }
}
