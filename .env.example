# ------------------------------------------------------------------
# Cameras Center - variables de entorno
# Copia este archivo a `.env` en la raiz del monorepo.
# ------------------------------------------------------------------

# --- SERVER (Render) ---
PORT=4000
NODE_ENV=development
# Origen permitido para CORS (la URL de Vercel en produccion)
CORS_ORIGIN=http://localhost:5173
# URL publica del server (la usa el agent para conectarse por WSS)
SERVER_WSS_URL=http://localhost:4000

# --- SUPABASE (F2) ---
# URL base del proyecto (sin /rest/v1)
SUPABASE_URL=https://koakhscqmprmqqtlytdg.supabase.co
# service_role key (Settings → API → service_role). NUNCA va al navegador.
SUPABASE_SERVICE_KEY=
# Esquema PostgREST (normalmente "public")
SUPABASE_SCHEMA=public
# false => sólo se puede crear el primer usuario
ALLOW_REGISTER=true

# --- AUTH ---
# Genera una con: openssl rand -hex 32   (minimo 32 bytes)
JWT_SECRET=
# Clave AES-256 para cifrar las credenciales RTSP en la BD.
# Formato: 64 caracteres hex (32 bytes) o base64 de 32 bytes
CAMERA_ENC_KEY=

# --- API PÚBLICA (F5) ---
# Peticiones por minuto y por IP para toda la API
RATE_LIMIT_RPM=300
# Intentos de login/registro por minuto y por IP (antifuerza bruta)
AUTH_RATE_LIMIT_RPM=10

# --- CLOUDINARY (F4) ---
# Dashboard → Product Environment Credentials → Project environment variable
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Comprobación: npm run cloud:ping   (añade --clean para borrar la de prueba)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=cameras-center
# Cada cuánto sube el server una miniatura automáticamente (ms)
THUMB_INTERVAL_MS=300000
# Edad máxima (ms) del frame aceptado para una captura manual
THUMB_MAX_AGE_MS=60000

# --- AGENT ---
AGENT_ID=agent-01
# Token que el agent presenta al server (F2). Si está vacío el server no valida.
AGENT_TOKEN=
# Puerto del servidor MJPEG local (visión en LAN)
AGENT_STREAM_PORT=4100
# Ruta a FFmpeg. Si se omite se busca en PATH y en las instalaciones de winget.
# FFMPEG_PATH=C:\Users\<usuario>\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_...\bin\ffmpeg.exe
FFMPEG_PATH=
# ms sin espectadores antes de apagar la transcodificación
AGENT_NO_VIEWER_STOP_MS=60000
# fps máximos que se reenvían al server por relay (F3) — baja esto si la subida es lenta
RELAY_FPS=6
# Carpeta local para snapshots / grabaciones
AGENT_DATA_DIR=./data

# --- TESTS (nunca commitear el valor real) ---
TEST_EMAIL=owner@cam.test
TEST_PASSWORD=

# --- WEB (Vercel) ---
# Vite solo expone variables con prefijo VITE_
VITE_SERVER_URL=http://localhost:4000
# Servidor de streams MJPEG del agent (visión en LAN)
VITE_AGENT_URL=http://localhost:4100
